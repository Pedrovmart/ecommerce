<?xml version="1.0" encoding="UTF-8"?>
<persistence
        xmlns="https://jakarta.ee/xml/ns/persistence"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
        version="3.0">

    <persistence-unit name="jakartaee-starter" transaction-type="JTA">
        <!-- Nome JNDI do datasource configurado no WildFly -->
        <jta-data-source>java:jboss/datasources/ExampleDS</jta-data-source>

        <!-- Classes das entidades que serão gerenciadas -->
        <class>br.com.ecommerce.domain.Produto</class>
        <class>br.com.ecommerce.domain.Carrinho</class>

        <properties>
            <!-- Configuração do Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Script de inicialização de dados -->
            <property name="jakarta.persistence.sql-load-script-source" value="META-INF/data.sql"/>
        </properties>
    </persistence-unit>
</persistence>
